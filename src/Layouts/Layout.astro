---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
}

const {
  title = "Mantenimiento Industrial Castro | Taller Electromecánico en Iztapalapa, CDMX",
  description = "Taller Mantenimiento Industrial Castro. Especialistas en mantenimiento preventivo, correctivo 24/7, maquinado en torno, fresadora y pailería en Calle San Ignacio 38, Iztapalapa, Ciudad de México.",
  currentPage = "",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="mantenimiento industrial castro, taller electromecanico iztapalapa, san ignacio 38 iztapalapa, maquinado torno fresadora cdmx, reparacion motores industriales iztapalapa, soldadura paileria cdmx" />
    <meta name="author" content="Mantenimiento Industrial Castro" />
    <meta name="geo.region" content="MX-CMX" />
    <meta name="geo.placename" content="Iztapalapa, Ciudad de México" />
    <meta name="geo.position" content="19.3638;-99.0994" />
    <meta name="ICBM" content="19.3638, -99.0994" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_MX" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon SVG con engranaje industrial -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23f59e0b'><path d='M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z'/><path d='M15 12a3 3 0 11-6 0 3 3 0 016 0z'/></svg>" />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased font-['Plus_Jakarta_Sans',sans-serif] min-h-screen flex flex-col selection:bg-amber-500 selection:text-slate-950">
    
    <Navbar currentPage={currentPage} />
    
    <div class="flex-grow">
      <slot />
    </div>

    <!-- Botón flotante de WhatsApp para emergencias industriales en CDMX -->
    <aside aria-label="Contacto rápido" class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-3">
      <a
        href="https://wa.me/525584236956?text=Hola%20Mantenimiento%20Industrial%20Castro,%20solicito%20atenci%C3%B3n%20para%20un%20servicio%20en%20CDMX"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-3 rounded-full shadow-2xl hover:shadow-emerald-500/30 transition-all duration-300 hover:scale-105"
        aria-label="Contactar por WhatsApp a Mantenimiento Industrial Castro"
      >
        <span class="max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-xs transition-all duration-300 text-xs font-bold tracking-wide uppercase">
          WhatsApp 55 8423 6956
        </span>
        <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.316 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.818-.981z"/>
        </svg>
      </a>
    </aside>

    <Footer />
  </body>
</html>
