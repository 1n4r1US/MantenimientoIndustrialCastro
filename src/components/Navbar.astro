---
interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;
---

<!-- Barra superior de contacto rápido y ubicación real -->
<div class="bg-slate-950 text-slate-300 text-xs py-2 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-2">
    <div class="flex items-center gap-4 flex-wrap justify-center sm:justify-start">
      <span class="inline-flex items-center gap-1.5 text-amber-400 font-medium">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Taller: Calle San Ignacio 38, Iztapalapa, CDMX
      </span>
      <span class="hidden md:inline-block text-slate-600">|</span>
      <span class="hidden md:inline-flex items-center gap-1.5 text-slate-300">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Atención y Urgencias: 24 Horas
      </span>
    </div>
    <div class="flex items-center gap-4 text-xs font-medium">
      <a href="tel:+525584236956" class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5 text-white font-semibold">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        (55) 8423-6956
      </a>
      <span class="text-slate-600">|</span>
      <a href="https://wa.me/525584236956?text=Hola%20Mantenimiento%20Industrial%20Castro,%20solicito%20atenci%C3%B3n%20para%20un%20servicio%20en%20CDMX" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 text-emerald-400 font-semibold inline-flex items-center gap-1">
        WhatsApp 55 8423 6956
      </a>
    </div>
  </div>
</div>

<!-- Header de Navegación Principal -->
<header class="sticky top-0 z-50 w-full bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- LOGO INDUSTRIAL CASTRO -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center text-slate-950 font-black text-2xl shadow-md group-hover:scale-105 transition-transform duration-200">
        <svg class="w-6 h-6 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-xl sm:text-2xl font-black text-white tracking-tight leading-none">
          CASTRO<span class="text-amber-500">.</span>
        </span>
        <span class="text-[10px] sm:text-xs font-semibold text-slate-400 uppercase tracking-widest mt-0.5">
          Mantenimiento Industrial • Iztapalapa, CDMX
        </span>
      </div>
    </a>

    <!-- ENLACES DE NAVEGACIÓN DESKTOP -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-300">
      <a
        href="/"
        class={`transition-colors py-1 border-b-2 ${currentPage === "home" ? "text-amber-400 border-amber-400 font-bold" : "border-transparent hover:text-white hover:border-slate-600"}`}
      >
        Inicio
      </a>
      <a
        href="/#servicios"
        class="border-b-2 border-transparent hover:text-white hover:border-slate-600 transition-colors py-1"
      >
        Servicios
      </a>
      <a
        href="/#maquinaria"
        class="border-b-2 border-transparent hover:text-white hover:border-slate-600 transition-colors py-1"
      >
        Taller y Maquinaria
      </a>
      <a
        href="/nosotros"
        class={`transition-colors py-1 border-b-2 ${currentPage === "nosotros" ? "text-amber-400 border-amber-400 font-bold" : "border-transparent hover:text-white hover:border-slate-600"}`}
      >
        Nosotros
      </a>
      <a
        href="/contacto"
        class={`transition-colors py-1 border-b-2 ${currentPage === "contacto" ? "text-amber-400 border-amber-400 font-bold" : "border-transparent hover:text-white hover:border-slate-600"}`}
      >
        Contacto y Ubicación
      </a>
    </nav>

    <!-- BOTÓN CTA & TELÉFONO -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/contacto"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-bold bg-amber-500 text-slate-950 shadow-md hover:bg-amber-400 hover:shadow-amber-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-150"
      >
        <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Cotizar Servicio
      </a>
    </div>

    <!-- BOTÓN HAMBURGUESA MÓVIL -->
    <div class="flex md:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
      >
        <svg id="menu-icon-bars" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- MENÚ MÓVIL DESPLEGABLE -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-slate-950 px-4 pt-3 pb-6 space-y-3">
    <a
      href="/"
      class={`block px-3 py-2 rounded-md text-base font-medium ${currentPage === "home" ? "bg-amber-500 text-slate-950 font-bold" : "text-slate-300 hover:bg-slate-800 hover:text-white"}`}
    >
      Inicio
    </a>
    <a
      href="/#servicios"
      class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:bg-slate-800 hover:text-white"
    >
      Servicios
    </a>
    <a
      href="/#maquinaria"
      class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:bg-slate-800 hover:text-white"
    >
      Taller y Maquinaria
    </a>
    <a
      href="/nosotros"
      class={`block px-3 py-2 rounded-md text-base font-medium ${currentPage === "nosotros" ? "bg-amber-500 text-slate-950 font-bold" : "text-slate-300 hover:bg-slate-800 hover:text-white"}`}
    >
      Nosotros
    </a>
    <a
      href="/contacto"
      class={`block px-3 py-2 rounded-md text-base font-medium ${currentPage === "contacto" ? "bg-amber-500 text-slate-950 font-bold" : "text-slate-300 hover:bg-slate-800 hover:text-white"}`}
    >
      Contacto y Ubicación (San Ignacio 38)
    </a>
    <div class="pt-2">
      <a
        href="/contacto"
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg text-base font-bold bg-amber-500 text-slate-950 shadow-md hover:bg-amber-400"
      >
        Cotizar Servicio Urgente
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconBars = document.getElementById("menu-icon-bars");
  const iconClose = document.getElementById("menu-icon-close");

  if (menuBtn && mobileMenu && iconBars && iconClose) {
    menuBtn.addEventListener("click", () => {
      const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", String(!isExpanded));
      mobileMenu.classList.toggle("hidden");
      iconBars.classList.toggle("hidden");
      iconClose.classList.toggle("hidden");
    });
  }
</script>
